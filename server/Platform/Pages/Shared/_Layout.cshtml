<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>@ViewData["Title"] · 电波接力</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
<a class="skip-link" href="#main-content">跳到主要内容</a>
<header>
<a class="brand" asp-page="/Index"><span class="brand-symbol" aria-hidden="true">⌁</span><span>电波接力 <small>TURING SIGNAL RELAY</small></span>
</a>
<nav aria-label="主导航">
<a asp-page="/Index" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "page" : null)">提交 AI</a>
<a asp-page="/History" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/History" ? "page" : null)">提交历史</a>
@if (User.IsInRole("Judge")) { <a asp-page="/Judge" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Judge" ? "page" : null)">裁判台</a> }
<a asp-page="/Results" aria-current="@(ViewContext.RouteData.Values["page"]?.ToString() == "/Results" ? "page" : null)">比赛结果</a>
@if (User.Identity?.IsAuthenticated == true) { <a asp-page="/Logout">@User.Identity.Name · 退出</a> }
</nav>
</header>
<main id="main-content">
@if (TempData["Message"] is string message) { <p class="notice" role="status">@message</p> }
@RenderBody()</main>
<footer><span>电波接力 <span class="footer-divider">/</span> 图灵杯 AI 竞赛平台</span><div><a href="/downloads/TuringSignalRelay-windows.zip">下载观战客户端 ↗</a><a href="/downloads/TuringSignalRelay-sdk.zip">C++17 SDK ↗</a></div></footer>
</body>
</html>
