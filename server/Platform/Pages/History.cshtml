@page
@model DemoPageModel
@{ ViewData["Title"] = "提交历史"; }
<h1>提交历史</h1>
<p>队伍版本与诊断记录</p>
<div class="table-wrap">
<table>
<caption>示例队伍的提交记录</caption>
<thead>
<tr>
<th>提交编号</th>
<th>版本说明</th>
<th>时间</th>
<th>状态</th>
<th>诊断</th>
</tr>
</thead>
<tbody>@foreach (var submission in Model.Submissions) {<tr>
<td>@submission.Id</td>
<td>@submission.Note</td>
<td>@submission.SubmittedAt</td>
<td>@submission.Status</td>
<td>
<pre>@submission.Diagnostic</pre>
</td>
</tr>}</tbody>
</table>
</div>